-- ===== FUNCTIONS =====

local function openMainHub()
	gui:Destroy()
	-- AUTO LOAD YOUR SCRIPT
	loadstring(game:HttpGet("https://pastefy.app/VPSYEV0n/raw"))()
end

local function checkVerified()
	local success, value = pcall(function()
		return VerifiedStore:GetAsync(player.UserId)
	end)
	if success and value == true then
		openMainHub()
	else
		gui.Enabled = true
	end
end

-- ===== LOGIC =====

-- Load saved verification
checkVerified()

verify.MouseButton1Click:Connect(function()
	if textbox.Text == CORRECT_KEY then
		status.Text = "✅ Verified!"
		status.TextColor3 = Color3.fromRGB(0,255,0)

		-- Save verified
		local success, err = pcall(function()
			VerifiedStore:SetAsync(player.UserId,true)
		end)
		if not success then
			warn("Failed to save verification: "..tostring(err))
		end

		task.wait(0.4)
		openMainHub()
	else
		status.Text = "❌ Wrong key!"
		status.TextColor3 = Color3.fromRGB(255,80,80)
	end
end)

getkey.MouseButton1Click:Connect(function()
	if setclipboard then
